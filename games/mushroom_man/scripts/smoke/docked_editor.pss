// Scripted smoke test for the docked editor (debug builds only).
//
// The docked editor is the game's only editor: F4, F2 and F1 each open it
// (F4 closes it again). Presses F4 (open), Play (F3), Stop (F3), F4 (close), F2
// (open), F4 (close), F1 (open), F4 (close). The harness injects these as
// in-process SDL events; nothing touches the desktop's input. Check the log for:
//   "docked editor opened" x3, "docked editor closed" x3 and
//   "entered play mode" ... "exited play mode, restored edit-time state"
// Run with:
//   cargo run -p mushroom_man -- --smoke-test scripts/smoke/docked_editor.pss

let phase = 0.0;
let phase_started_at = 0.0;

fn enter_phase(next) {
    phase = next;
    phase_started_at = time();
    log("entering phase " + next);
}

fn seconds_in_phase() {
    return time() - phase_started_at;
}

fn key(name) {
    press(name);
    release(name);
}

fn tick() {
    if phase == 0.0 {
        if seconds_in_phase() > 0.5 {
            key("F4");
            enter_phase(1.0);
        }
    } else if phase == 1.0 {
        if seconds_in_phase() > 1.0 {
            key("F3");
            enter_phase(2.0);
        }
    } else if phase == 2.0 {
        if seconds_in_phase() > 1.5 {
            key("F3");
            enter_phase(3.0);
        }
    } else if phase == 3.0 {
        if seconds_in_phase() > 1.0 {
            key("F4");
            enter_phase(4.0);
        }
    } else if phase == 4.0 {
        if seconds_in_phase() > 0.5 {
            key("F2");
            enter_phase(5.0);
        }
    } else if phase == 5.0 {
        if seconds_in_phase() > 0.7 {
            key("F4");
            enter_phase(6.0);
        }
    } else if phase == 6.0 {
        if seconds_in_phase() > 0.5 {
            key("F1");
            enter_phase(7.0);
        }
    } else if phase == 7.0 {
        if seconds_in_phase() > 0.7 {
            key("F4");
            enter_phase(8.0);
        }
    } else if phase == 8.0 {
        if seconds_in_phase() > 0.5 {
            log("docked editor smoke test passed");
            finish(true);
        }
    }
}
