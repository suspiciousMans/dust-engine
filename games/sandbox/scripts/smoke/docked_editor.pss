// Smoke test for the F4 docked editor: open it, Play (F3), hold W for a moment
// with the mouse captured, Stop (F3, scene restored via apply_level), close it.
// Debug builds only (the docked editor does not exist in release).
//   cargo run -p sandbox -- --smoke-test scripts/smoke/docked_editor.pss

let phase = 0.0;
let phase_started_at = 0.0;

fn enter_phase(next) {
    phase = next;
    phase_started_at = time();
    log("entering phase " + next);
}

fn seconds_in_phase() {
    return time() - phase_started_at;
}

fn tick() {
    if phase == 0.0 {
        if seconds_in_phase() > 0.5 {
            press("F4");
            release("F4");
            enter_phase(1.0);
        }
    } else if phase == 1.0 {
        // Let the dock lay out and render a few frames in Edit mode.
        if seconds_in_phase() > 1.0 {
            press("F3");
            release("F3");
            enter_phase(2.0);
        }
    } else if phase == 2.0 {
        if seconds_in_phase() > 0.5 {
            press("W");
            enter_phase(3.0);
        }
    } else if phase == 3.0 {
        if seconds_in_phase() > 1.0 {
            release("W");
            press("F3");
            release("F3");
            enter_phase(4.0);
        }
    } else if phase == 4.0 {
        // Edit mode again; give the restored scene a few frames, then close the dock.
        if seconds_in_phase() > 1.0 {
            press("F4");
            release("F4");
            enter_phase(5.0);
        }
    } else if phase == 5.0 {
        if seconds_in_phase() > 0.5 {
            log("docked editor smoke test passed");
            finish(true);
        }
    }
}
