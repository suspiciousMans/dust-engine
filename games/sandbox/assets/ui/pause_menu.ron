// Sandbox pause menu (no dim layer: the multiplayer/appearance side panels are
// egui windows underneath the designer layer and would be dimmed with it).
// Edit in the UI Designer tab and Save; the running game
// hot-reloads it.
//
// Events the game handles (Button on_click / Toggle on_toggle):
//   resume_game, exit_to_editor, restart_level, quit_game, toggle_stats (bool)
// Bindings published by the game:
//   editor_available (bool) picks "Exit to Editor" vs "Restart Level"
//   hud.show_stats (bool)   state of the "Frame stats" toggle
(
    name: "pause_menu",
    scale_mode: ScaleWithScreen(reference: (1280.0, 720.0), match_height: 0.5),
    respect_safe_area: true,
    styles: (
        classes: {
            "window": (
                base: (
                    bg_color: Some((0.11, 0.12, 0.15, 0.97)),
                    border_width: Some(1.0),
                    border_color: Some((0.35, 0.37, 0.45, 1.0)),
                    corner_radius: Some(6.0),
                ),
            ),
            "title": (base: (font_size: Some(18.0), text_align: Some(Center))),
            "Button": (base: (text_align: Some(Center))),
            "button": (
                base: (
                    bg_color: Some((0.20, 0.22, 0.29, 1.0)),
                    border_width: Some(1.0),
                    border_color: Some((0.40, 0.43, 0.55, 1.0)),
                    corner_radius: Some(4.0),
                    font_size: Some(16.0),
                ),
                hover: (bg_color: Some((0.28, 0.32, 0.43, 1.0))),
                pressed: (bg_color: Some((0.14, 0.16, 0.22, 1.0))),
                disabled: (bg_color: Some((0.15, 0.15, 0.17, 1.0)), text_color: Some((0.5, 0.5, 0.5, 1.0))),
                focused: (border_color: Some((1.0, 0.85, 0.3, 1.0)), border_width: Some(2.0)),
            ),
            "toggle": (base: (font_size: Some(15.0), accent_color: Some((0.3, 0.7, 0.3, 1.0)))),
        },
    ),
    root: (
        name: "Root",
        kind: Panel,
        children: [
            (
                name: "Window",
                kind: Panel,
                classes: ["window"],
                anchor_min: (0.5, 0.5),
                anchor_max: (0.5, 0.5),
                pivot: (0.5, 0.5),
                width: Fixed(240.0),
                height: Fit,
                padding: (left: 12.0, top: 12.0, right: 12.0, bottom: 12.0),
                children: [
                    (
                        name: "Content",
                        kind: VStack(spacing: 8.0, cross_align: Stretch),
                        height: Fit,
                        children: [
                            (name: "Title", kind: Label(text: "Paused"), classes: ["title"], height: Fit),
                            (
                                name: "ResumeButton",
                                kind: Button(text: "Resume", on_click: Some("resume_game")),
                                classes: ["button"],
                                height: Fit,
                                padding: (left: 8.0, top: 6.0, right: 8.0, bottom: 6.0),
                            ),
                            (
                                name: "ExitToEditorButton",
                                kind: Button(text: "Exit to Editor", on_click: Some("exit_to_editor")),
                                classes: ["button"],
                                height: Fit,
                                padding: (left: 8.0, top: 6.0, right: 8.0, bottom: 6.0),
                                bindings: {"visible": "editor_available"},
                            ),
                            (
                                name: "RestartLevelButton",
                                kind: Button(text: "Restart Level", on_click: Some("restart_level")),
                                classes: ["button"],
                                height: Fit,
                                padding: (left: 8.0, top: 6.0, right: 8.0, bottom: 6.0),
                                bindings: {"visible": "!editor_available"},
                            ),
                            (
                                name: "StatsToggle",
                                kind: Toggle(text: "Show frame stats", checked: false, on_toggle: Some("toggle_stats")),
                                classes: ["toggle"],
                                height: Fit,
                                padding: (left: 4.0, top: 2.0, right: 4.0, bottom: 2.0),
                                bindings: {"checked": "hud.show_stats"},
                            ),
                            (
                                name: "QuitButton",
                                kind: Button(text: "Quit Game", on_click: Some("quit_game")),
                                classes: ["button"],
                                height: Fit,
                                padding: (left: 8.0, top: 6.0, right: 8.0, bottom: 6.0),
                            ),
                        ],
                    ),
                ],
            ),
        ],
    ),
)
