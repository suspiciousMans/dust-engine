// HUD — reproduces engine/src/ui/hud.rs (draw_hud): optional title, progress
// bars with "Name: NN%" text, and fading toasts, stacked at the top-left.
// Bindings are published from HudState by ui_designer::examples::publish_hud.
(
    name: "hud",
    scale_mode: ScaleWithScreen(reference: (1280.0, 720.0), match_height: 0.5),
    respect_safe_area: true,
    styles: (
        classes: {
            "hud_title": (base: (font_size: Some(20.0))),
            "bar": (
                base: (
                    bg_color: Some((0.12, 0.12, 0.12, 0.85)),
                    accent_color: Some((0.3, 0.7, 0.3, 1.0)),
                    corner_radius: Some(2.0),
                    font_size: Some(12.0),
                ),
            ),
            "stamina_bar": (parent: Some("bar"), base: (accent_color: Some((0.85, 0.7, 0.2, 1.0)))),
            "toast": (base: (text_color: Some((1.0, 1.0, 1.0, 1.0)))),
        },
    ),
    root: (
        name: "Root",
        kind: Panel,
        children: [
            (
                name: "TopLeft",
                kind: VStack(spacing: 4.0),
                anchor_min: (0.0, 0.0),
                anchor_max: (0.0, 0.0),
                pivot: (0.0, 0.0),
                offset_min: (12.0, 12.0),
                width: Fixed(160.0),
                height: Fit,
                children: [
                    (
                        name: "Title",
                        kind: Label(text: ""),
                        classes: ["hud_title"],
                        width: Fit,
                        height: Fit,
                        bindings: {"text": "{hud.title}", "visible": "hud.has_title"},
                    ),
                    (
                        name: "HealthBar",
                        kind: ProgressBar(value: 0.0, min: 0.0, max: 1.0),
                        classes: ["bar"],
                        height: Fixed(16.0),
                        bindings: {
                            "value": "hud.bar.health",
                            "text": "Health: {hud.bar.health_pct:.0}%",
                            "visible": "hud.bar.health.visible",
                        },
                    ),
                    (
                        name: "StaminaBar",
                        kind: ProgressBar(value: 0.0, min: 0.0, max: 1.0),
                        classes: ["stamina_bar"],
                        height: Fixed(16.0),
                        bindings: {
                            "value": "hud.bar.stamina",
                            "text": "Stamina: {hud.bar.stamina_pct:.0}%",
                            "visible": "hud.bar.stamina.visible",
                        },
                    ),
                    (
                        name: "Toast0",
                        kind: Label(text: ""),
                        classes: ["toast"],
                        width: Fit,
                        height: Fit,
                        bindings: {"text": "{hud.toast.0.text}", "visible": "hud.toast.0.visible", "opacity": "hud.toast.0.alpha"},
                    ),
                    (
                        name: "Toast1",
                        kind: Label(text: ""),
                        classes: ["toast"],
                        width: Fit,
                        height: Fit,
                        bindings: {"text": "{hud.toast.1.text}", "visible": "hud.toast.1.visible", "opacity": "hud.toast.1.alpha"},
                    ),
                    (
                        name: "Toast2",
                        kind: Label(text: ""),
                        classes: ["toast"],
                        width: Fit,
                        height: Fit,
                        bindings: {"text": "{hud.toast.2.text}", "visible": "hud.toast.2.visible", "opacity": "hud.toast.2.alpha"},
                    ),
                ],
            ),
        ],
    ),
)
